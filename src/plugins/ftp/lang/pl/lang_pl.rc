/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDM_SRVCONTEXTMENU MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "&Połącz\tEnter",              IDOK
        MENUITEM SEPARATOR
        MENUITEM "N&owy...\tInsert",            IDB_NEWBOOKMARK
        MENUITEM "Kopiuj &do...",               CM_COPYSRVTO
        MENUITEM "Z&mień nazwę...\tF2",         IDB_RENAMEBOOKMARK
        MENUITEM "&Usuń...\tDelete",            IDB_REMOVEBOOKMARK
        MENUITEM SEPARATOR
        MENUITEM "Przenieś &wyżej\tAlt+Up Arrow",      CM_MOVEUPBOOKMARK
        MENUITEM "Przenieś &niżej\tAlt+Down Arrow",    CM_MOVEDOWNBOOKMARK
    END
END

IDM_SRVCONTEXTMENU2 MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "N&owy...\tInsert",            IDB_NEWBOOKMARK
        MENUITEM "Kopiuj &do...",               CM_COPYSRVTO
        MENUITEM "Z&mień nazwę...\tF2",         IDB_RENAMEBOOKMARK
        MENUITEM "&Usuń...\tDelete",            IDB_REMOVEBOOKMARK
        MENUITEM SEPARATOR
        MENUITEM "Przenieś &wyżej\tAlt+Up Arrow",      CM_MOVEUPBOOKMARK
        MENUITEM "Przenieś &niżej\tAlt+Down Arrow",    CM_MOVEDOWNBOOKMARK
    END
END

IDM_ACTPATHCONTEXTMENU MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "&Rozłącz...",                 CM_DISCONNECTSRV
        MENUITEM "Pokaż &certyfikat...",        CM_SHOWCERT
        POPUP "Tryb &przesyłu"
        BEGIN
            MENUITEM "&Automatyczny",               CM_TRMODEAUTO
            MENUITEM "A&SCII",                      CM_TRMODEASCII
            MENUITEM "&Binarny",                    CM_TRMODEBINARY
        END
        MENUITEM "&Odśwież",                    CM_REFRESHPATH
        MENUITEM SEPARATOR
        MENUITEM "&Dodaj zakładkę...",          CM_ADDBOOKMARK
        MENUITEM "Pokaż d&ziennik...",          CM_SHOWLOG
        MENUITEM "&Wyślij polecenie FTP...",    CM_SENDFTPCOMMAND
        MENUITEM "Po&każ surowe listowanie...", CM_SHOWRAWLISTING
        MENUITEM "Wyświetlaj &ukryte pliki i katalogi (Unix)", CM_LISTHIDDENFILES
    END
END

IDM_CHNGDRVCONTMENU MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "&Połącz z serwerem FTP...",   CM_CONNECTSRV
        MENUITEM "&Zarządzaj zakładkami...",    CM_ORGBOOKMARKS
        MENUITEM "Pokaż &dzienniki...",         CM_SHOWLOGS
    END
END

IDM_DETPATHCONTEXTMENU MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "&Pokaż w panelu",             CM_OPENDETACHED
        MENUITEM SEPARATOR
        MENUITEM "&Rozłącz",                    CM_DISCONNECTSRV
        MENUITEM SEPARATOR
        MENUITEM "&Dodaj zakładkę...",          CM_ADDBOOKMARK
        MENUITEM "Pokaż d&ziennik...",          CM_SHOWLOG
    END
END

IDM_LOGSMENU MENU 
BEGIN
    POPUP "&Dziennik"
    BEGIN
        MENUITEM "&Kopiuj",                     CM_COPYLOG
        MENUITEM "Kopiuj &wszystko",            CM_COPYALLLOGS
        MENUITEM SEPARATOR
        MENUITEM "Zapisz &jako...",             CM_SAVELOG
        MENUITEM "Zapisz wszy&stkie jako...",   CM_SAVEALLLOGS
        MENUITEM SEPARATOR
        MENUITEM "Wy&czyść...",                 CM_CLEARLOG
        MENUITEM "&Usuń...",                    CM_REMOVELOG
        MENUITEM "Usuń wszystk&ie...",          CM_REMOVEALLLOGS
        MENUITEM SEPARATOR

        MENUITEM SEPARATOR
        MENUITEM "Wy&tnij",                     CM_STRM_CUT
        MENUITEM "&Kopiuj",                     CM_STRM_COPY
        MENUITEM "&Wklej",                      CM_STRM_PASTE
        MENUITEM "&Usuń",                       CM_STRM_DELETE
        MENUITEM SEPARATOR
        MENUITEM "Zazna&cz wszystko",           CM_STRM_SELECTALL
    END
END


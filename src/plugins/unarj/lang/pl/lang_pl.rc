IDD_CHANGEDISK DIALOGEX 6, 15, 194, 110
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Następna część archiwum"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Włóż dysk z następną częścią archiwum lub znajdź odpowiedni plik na dysku.\n\nGdy będzie gotowe, kliknij OK.",IDC_STATIC_1,12,9,170,32
    LTEXT           "Poprzednia część:",IDC_STATIC_2,12,48,60,8

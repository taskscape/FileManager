    RTEXT           "Błąd:",IDC_STATIC_2,6,23,26,8,NOT WS_GROUP
    LTEXT           "Plik nie może być rozpakowany, ponieważ jest kontynuowany z poprzedniej części archiwum. Aby rozpakować ten plik, należy zacząć od części, w której plik się zaczyna.",IDC_STATIC_3,36,23,309,16,SS_NOPREFIX | NOT WS_GROUP
    CONTROL         "&Nie pokazuj tego komunikatu w przyszłości.",IDC_DONTSHOW,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,36,44,183,12
    DEFPUSHBUTTON   "OK",IDOK,121,63,50,14,WS_GROUP
    PUSHBUTTON      "Anuluj",IDCANCEL,181,63,50,14
END


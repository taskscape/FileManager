IDM_SFXMENU MENU
BEGIN
    POPUP "&Plik"
    BEGIN
        MENUITEM "&Eksportuj ustawienia...\tCtrl+E", CM_SFX_EXPORT
        MENUITEM "&Importuj ustawienia...\tCtrl+I", CM_SFX_IMPORT
    END
    POPUP "&Widok"
    BEGIN
        MENUITEM "Po&dgląd okna SFX...\tCtr+V", CM_SFX_PREVIEW
    END
    POPUP "&Opcje"
    BEGIN
        MENUITEM "&Resetuj wszystko\tCtrl+Shift+R",    CM_SFX_RESETALL
        MENUITEM "Resetuj &wartości\tCtrl+R",       CM_SFX_RESETVALUES
        MENUITEM "Resetuj &teksty\tCtrl+T",        CM_SFX_RESETTEXTS
        MENUITEM SEPARATOR
        MENUITEM "&Dodaj do ulubionych...\tCtrl+A", CM_SFX_ADD
        MENUITEM "&Ulubione\tCtrl+F",          CM_SFX_FAVORITIES
        MENUITEM SEPARATOR
        MENUITEM "&Ostatnio używane\tCtrl+L",          CM_SFX_LASTUSED
    END
END

IDM_FAVMANMENU MENU
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "Zmień &nazwę",                     CM_FAVRENAME
        MENUITEM "&Usuń",                     CM_FAVDELETE
        MENUITEM SEPARATOR
        MENUITEM "Usuń &wszystkie",                 CM_FAVREMOVEALL
    END
END

IDM_COMMENTMENU MENU
BEGIN
    POPUP "&Plik"
    BEGIN
        MENUITEM "&Zapisz",                       CM_SAVE
        MENUITEM SEPARATOR
        MENUITEM "&Zamknij\tAlt+F4",              CM_CLOSE
    END
END

IDM_SPECDIR MENU
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "Katalog &tymczasowy",        CM_TEMP
        MENUITEM "&Program Files",              CM_PROGFILES
        MENUITEM "Katalog &Windows",          CM_WINDIR
        MENUITEM "Katalog &systemowy",           CM_SYSDIR
        MENUITEM SEPARATOR
        MENUITEM "Z&mienna środowiskowa",       CM_ENVVAR
        MENUITEM "Wpis &rejestru",             CM_REGENTRY
    END
END



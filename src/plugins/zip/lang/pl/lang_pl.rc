    LTEXT           "&Komunikat:",IDC_STATIC_7,20,117,34,8,NOT WS_GROUP
    EDITTEXT        IDC_MBOXTEXT,20,127,221,29,ES_MULTILINE | ES_AUTOVSCROLL | ES_AUTOHSCROLL | ES_WANTRETURN | WS_VSCROLL
    GROUPBOX        "Główne okno dialogowe",IDC_STATIC_8,8,169,245,158
    LTEXT           "&Tytuł:",IDC_STATIC_9,20,179,28,8
    EDITTEXT        IDC_TITLE,20,189,221,12,ES_AUTOHSCROLL
    LTEXT           "Tekst &wyświetlany w oknie dialogowym:",IDC_STATIC_10,20,205,112,8,NOT WS_GROUP
    EDITTEXT        IDC_TEXT,20,215,221,29,ES_MULTILINE | ES_AUTOVSCROLL | ES_AUTOHSCROLL | ES_WANTRETURN | WS_VSCROLL
    LTEXT           "Tekst na przycisku „R&ozpakuj”:",IDC_STATIC_11,20,247,94,8,NOT WS_GROUP
    EDITTEXT        IDC_BUTTONTEXT,20,257,68,12,ES_AUTOHSCROLL
    LTEXT           "Nazwa &producenta:",IDS_VENDOR,20,272,174,8

IDD_WAITFOR DIALOGEX 15, 24, 227, 147
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Czekaj na"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Ta opcja pozwala czekać na inny proces niż proces określony w polu „Polecenie”. Po zakończeniu tego procesu moduł samorozpakowujący usuwa pliki tymczasowe i kończy działanie.",IDC_STATIC_1,12,9,200,32
    LTEXT           "Jest to konieczne tylko wtedy, gdy program instalacyjny uruchamia inny plik wykonywalny, który kontynuuje instalację po zakończeniu oryginalnego programu instalacyjnego.\nW ten sposób zachowują się np. niektóre wersje Install Shield.",IDC_STATIC_2,12,49,200,32
    LTEXT           "&Nazwa pliku wykonywalnego:",IDC_STATIC_3,12,89,103,8
    EDITTEXT        IDC_FILENAME,12,99,200,12,ES_AUTOHSCROLL
    LTEXT           "",IDC_STATIC_4,3,121,221,1,SS_ETCHEDHORZ | WS_GROUP
    DEFPUSHBUTTON   "OK",IDOK,28,128,50,14
    PUSHBUTTON      "Anuluj",IDCANCEL,88,128,50,14
    PUSHBUTTON      "Pomoc",IDHELP,148,128,50,14
END

IDD_CHANGELANG DIALOGEX 6, 15, 248, 114
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Zmiana tekstów modułu samorozpakowującego"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Zmieniłeś/-aś język modułu samorozpakowującego. Czy teksty niestandardowe wpisane w oknie „Teksty modułu samorozpakowującego” mają zostać zastąpione wartościami domyślnymi odpowiadającymi wybranemu językowi?",IDC_STATIC_1,11,8,214,32
    DEFPUSHBUTTON   "Tak",IDOK,40,48,50,14
    PUSHBUTTON      "Nie",IDCANCEL,99,48,50,14
    PUSHBUTTON      "Pomoc",IDHELP,158,48,50,14
    CONTROL         "",IDC_STATIC_2,"Static",SS_ETCHEDHORZ | WS_GROUP,3,70,242,1
    CONTROL         "Zawsze &pytaj przed zmianą tekstów",IDC_ASK,"Button",BS_AUTORADIOBUTTON,11,74,127,12
    CONTROL         "W przyszłości automatycznie &zastępuj teksty ich wartościami domyślnymi",IDC_REPLACE,
                    "Button",BS_AUTORADIOBUTTON,11,86,228,12
    CONTROL         "Nie pytaj w przyszłości i zawsze zostawiaj teksty &niezmienione",IDC_LEAVE,
                    "Button",BS_AUTORADIOBUTTON,11,98,205,12
END



STRINGTABLE
{
  IDS_SFX_COMMENT_HEAD1, ";Ustawienia modułu samorozpakowującego\r\n\r\n;To jest plik ustawień modułu samorozpakowującego.\r\n;\r\n;Składnia formatu pliku:\r\n;\r\n"
  IDS_SFX_COMMENT_HEAD2, ";Wiersze zaczynające się znakiem „;” są traktowane jako komentarze i są\r\n;ignorowane podczas przetwarzania pliku ustawień.\r\n;\r\n"
  IDS_SFX_COMMENT_HEAD3, ";Wszystkie zmienne poza version są opcjonalne. Jeśli zmienna nie zostanie\r\n;znaleziona w pliku ustawień, używana jest jej wartość domyślna.\r\n;Domyślne wartości zmiennych zależnych od języka (dlg_text, dlg_title,\r\n;button_text) pochodzą z pakietu sfx.\r\n;\r\n"
  IDS_SFX_COMMENT_HEAD4, ";Wszystkie wartości tekstowe, w tym puste ciągi, należy ująć w\r\n;podwójne cudzysłowy. Aby wpisać podwójny cudzysłów w ciągu, użyj dwóch\r\n;następujących po sobie podwójnych cudzysłowów.\r\n;\r\n;Liczb nie wolno ujmować w podwójne cudzysłowy.\r\n\r\n"
  IDS_SFX_COMMENT_VERSION, "\r\n;wersja pliku ustawień, bieżąca wersja to 2\r\n;to jedyna obowiązkowa zmienna\r\n\r\n"
  IDS_SFX_COMMENT_TARGDIR1, "\r\n;określenie katalogu docelowego — może to być ścieżka bezwzględna\r\n;lub względna; ścieżka względna jest względna względem katalogu\r\n;bieżącego w momencie uruchomienia pliku wykonywalnego sfx\r\n"
  IDS_SFX_COMMENT_TARGDIR2, ";na początku (!) ciągu „target_dir” można też użyć zdefiniowanych\r\n;zmiennych:\r\n;\r\n"
  IDS_SFX_COMMENT_TARGDIR3, ";  $(Temp)      katalog tymczasowy, powinien występować wyłącznie sam\r\n;               w polu target_dir, bez żadnej dalszej części ścieżki\r\n"
  IDS_SFX_COMMENT_TARGDIR4, ";  $(ProgFiles) folder „Program Files” użytkownika\r\n;  $(WinDir)    katalog Windows\r\n;  $(SysDir)    katalog systemowy\r\n"
  IDS_SFX_COMMENT_TARGDIR5, ";  $[zmienna]   wartość zmiennej środowiskowej opisanej przez\r\n;               „zmienna”\r\n;  $<klucz_rejestru> wartość wpisu rejestru opisanego przez „klucz_rejestru”\r\n;  np. SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\ProgramFilesDir\r\n\r\n"
  IDS_SFX_COMMENT_ALLOWCHANGE, "\r\n;określa, czy użytkownik może zmienić katalog docelowy podczas\r\n;rozpakowywania\r\n;ustaw jej wartość na 1, aby włączyć tę opcję\r\n\r\n"
  IDS_SFX_COMMENT_REMOVE1, "\r\n;określa, czy usuwać rozpakowane pliki z folderu tymczasowego po\r\n;zakończeniu programu określonego zmienną „command”\r\n"
  IDS_SFX_COMMENT_REMOVE2, ";ustaw jej wartość na 1, aby usuwać pliki tymczasowe\r\n;użycie tej zmiennej ma sens tylko wtedy, gdy „target_dir” jest ustawione\r\n;na ""$(Temp)"", w przeciwnym razie wartość jest ignorowana\r\n\r\n"
  IDS_SFX_COMMENT_AUTO, "\r\n;określa, czy rozpocząć rozpakowywanie automatycznie po uruchomieniu\r\n;archiwum samorozpakowującego przez użytkownika\r\n;ustaw jej wartość na 1, aby rozpakowywanie rozpoczynało się automatycznie\r\n\r\n"
  IDS_SFX_COMMENT_SUMMARY, "\r\n;określa, czy po zakończeniu rozpakowywania plików pokazać okno\r\n;komunikatu powiadamiające o powodzeniu operacji\r\n;ustaw jej wartość na 1, aby pokazać podsumowanie operacji\r\n\r\n"
  IDS_SFX_COMMENT_HIDE, "\r\n;określa, czy pokazać główne okno dialogowe modułu samorozpakowującego\r\n;ustaw jej wartość na 1, jeśli nie chcesz pokazywać głównego okna sfx\r\n;użycie tej zmiennej ma sens tylko wtedy, gdy „autostart” jest ustawione na 1,\r\n;w przeciwnym razie wartość jest ignorowana\r\n\r\n"
  IDS_SFX_COMMENT_OVERWRITE, "\r\n;określa, czy automatycznie nadpisywać wszystkie pliki w katalogu\r\n;docelowym\r\n;ustaw jej wartość na 1, aby pliki były nadpisywane automatycznie\r\n\r\n"
  IDS_SFX_COMMENT_AUTODIR, "\r\n;określa, czy tworzyć katalog docelowy automatycznie, bez pytania\r\n;użytkownika\r\n;ustaw jej wartość na 1, aby katalog docelowy był tworzony automatycznie\r\n\r\n"
  IDS_SFX_COMMENT_COMMAND, "\r\n;program, łącze http lub dokument do uruchomienia/otwarcia po pomyślnym\r\n;zakończeniu rozpakowywania plików; ścieżka jest względna względem katalogu\r\n;docelowego rozpakowania; jeśli podasz program, możesz też wpisać jego argumenty\r\n\r\n"
  IDS_SFX_COMMENT_PACKAGE, "\r\n;pakiet sfx używany przy tworzeniu archiwum samorozpakowującego\r\n;ścieżka względna jest względna względem katalogu z plikiem zip2sfx.exe\r\n\r\n"
  IDS_SFX_COMMENT_MBUT, "\r\n;przyciski w opcjonalnym oknie komunikatu\r\n;może to być jedna z następujących wartości: ""ok"", ""ok_cancel"", ""yes_no"",\r\n;""agree_disagree""\r\n\r\n"
  IDS_SFX_COMMENT_MICO, "\r\n;typ opcjonalnego okna komunikatu\r\n;może to być jedna z następujących wartości: ""simple"", ""exclamation"", ""information"",\r\n;""question"", ""long_message""\r\n\r\n"
  IDS_SFX_COMMENT_MBOX, "\r\n;tekst i tytuł opcjonalnego okna komunikatu pokazywanego przed\r\n;rozpoczęciem rozpakowywania\r\n;jeśli nie chcesz wyświetlać żadnego okna komunikatu, zostaw oba pola\r\n;puste ("""")\r\n\r\n"
  IDS_SFX_COMMENT_TEXT, "\r\n;tekst wyświetlany w głównym oknie dialogowym modułu samorozpakowującego\r\n\r\n"
  IDS_SFX_COMMENT_TITLE, "\r\n;tytuł głównego okna dialogowego modułu samorozpakowującego\r\n\r\n"
  IDS_SFX_COMMENT_BUTTON, "\r\n;tekst na przycisku rozpakowywania w głównym oknie sfx\r\n\r\n"
  IDS_SFX_COMMENT_VENDOR, "\r\n;nazwa producenta w lewym dolnym rogu głównego okna sfx\r\n\r\n"
  IDS_SFX_COMMENT_WWW, "\r\n;łącze www w prawym dolnym rogu głównego okna sfx\r\n\r\n"
  IDS_SFX_COMMENT_ICOFILE, "\r\n;pliki zawierające dane ikony — może to być plik ICO lub plik wykonywalny\r\n;PE (np. pliki EXE lub DLL Win32) zawierający ikonę\r\n;ścieżka względna jest względna względem katalogu z plikiem zip2sfx.exe\r\n\r\n"
  IDS_SFX_COMMENT_ICOINDEX, "\r\n;wartość dodatnia oznacza indeks ikony w pliku wykonywalnym określonym\r\n;zmienną „icon_file”\r\n;wartość ujemna oznacza identyfikator zasobu (resource ID) ikony\r\n;dla plików ICO indeks zawsze wynosi 0 i jego wartość jest ignorowana\r\n\r\n"
  IDS_SFX_COMMENT_WAITFOR1, "\r\n;Ta opcja pozwala czekać na inny proces niż proces określony\r\n;w polu „Command”. Po zakończeniu tego procesu moduł samorozpakowujący\r\n;usuwa pliki tymczasowe, a następnie kończy działanie.\r\n"
  IDS_SFX_COMMENT_WAITFOR2, ";Jest to konieczne tylko wtedy, gdy program instalacyjny uruchamia inny\r\n;plik wykonywalny, który kontynuuje instalację po zakończeniu oryginalnego\r\n;programu instalacyjnego.\r\n"
  IDS_SFX_COMMENT_WAITFOR3, ";W ten sposób zachowują się np. niektóre wersje Install Shield.\r\n;Ta opcja jest ignorowana, chyba że „remove_temp” jest ustawione na 1.\r\n\r\n"
  IDS_SFX_COMMENT_REQUIRESADMIN, "\r\n;wymaga uprawnień administracyjnych do uruchomienia w systemie Windows Vista lub nowszym\r\n\r\n"
}

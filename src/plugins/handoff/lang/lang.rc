    LTEXT           "", IDC_HO_SPEC_SUMMARY, 76, 91, 257, 18, SS_NOPREFIX
    LTEXT           "V&ariables:", -1, 7, 113, 66, 8
    CONTROL         "", IDC_HO_VARIABLES, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER | WS_BORDER | WS_TABSTOP, 76, 112, 257, 80

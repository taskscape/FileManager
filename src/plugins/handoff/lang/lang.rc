    COMBOBOX        IDC_HO_VARIABLE_CHOICE, 76, 197, 257, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Package folder:", -1, 7, 216, 66, 8
    LTEXT           "", IDC_HO_PACKAGE_NAME, 76, 216, 257, 8, SS_NOPREFIX
    LTEXT           "", IDC_HO_PACKAGE_STATUS, 76, 228, 257, 18, SS_NOPREFIX

{
  "$comment": "Design studio handoff: logos in vector and exact raster sizes, the latest approved guidelines, and licensed fonts. Adjust folders to your project layout.",
  "handoffSpec": 1,
  "id": "studio.brand-handoff",
  "name": "Design studio handoff",
  "revision": "2026.1",
  "description": "Brand handoff with logos, guidelines, and licensed fonts.",
  "variables": {
    "client":  { "label": "Client", "required": true, "pattern": "^[A-Za-z0-9-]{2,24}$" },
    "brand":   { "label": "Brand or product", "required": true, "pattern": "^[A-Za-z0-9-]{2,32}$" },
    "version": { "label": "Handoff version", "default": "v1", "pattern": "^v\\d{1,3}$" }
  },
  "package": {
    "folderName": "{client}-{brand}_Brand-Handoff_{version}_{date:yyyyMMdd}",
    "contents": { "title": "{client} {brand} — brand handoff", "groupBy": "rule" },
    "limits": { "maxFiles": 3000, "maxRelativePathLength": 160 }
  },
  "naming": { "charset": "portable", "case": "keep", "maxNameLength": 100 },
  "content": {
    "allowedFormats": ["svg", "ai", "eps", "pdf", "png", "otf", "ttf", "woff", "woff2", "txt"],
    "forbid": ["**/Thumbs.db", "**/.DS_Store", "**/desktop.ini", "**/~$*", "**/*.tmp", "**/*.bak", "**/__MACOSX/**", "**/.git/**", "**/*working*", "**/*.psd"],
    "emptyFiles": "forbid",
    "unassigned": "info"
  },
  "rules": [
    {
      "id": "logo-vector",
      "title": "Logo (vector)",
      "role": "deliverable",
      "required": true,
      "select": { "include": ["Logos/**/*.{svg,ai,eps}"] },
      "formats": ["svg", "ai", "eps"],
      "target": { "folder": "01_Logo/Vector", "keepSubfolders": true }
    },
    {
      "id": "logo-raster",
      "title": "Logo (PNG)",
      "role": "deliverable",
      "required": true,
      "select": { "include": ["Logos/**/*.png"] },
      "formats": ["png"],
      "image": {
        "exact": [ { "width": 512, "height": 512 }, { "width": 1024, "height": 1024 }, { "width": 2048, "height": 2048 } ],
        "colorModel": ["rgb"],
        "alpha": "required"
      },
      "target": { "folder": "01_Logo/PNG" }
    },
    {
      "id": "guidelines",
      "title": "Brand guidelines",
      "role": "document",
      "required": true,
      "count": { "min": 1, "max": 1 },
      "select": {
        "include": ["Guidelines/**/*.pdf"],
        "exclude": ["**/*draft*"],
        "latestRevision": { "regex": "_v(\\d+)$" }
      },
      "formats": ["pdf"],
      "pdf": { "pages": { "min": 1 }, "allowPasswordProtected": false },
      "approval": { "mode": "evidenceAndConfirm", "evidence": { "pathRegex": "(^|/)Approved/" } },
      "target": { "folder": "02_Guidelines", "name": "{client}-{brand}_Guidelines{ext}" }
    },
    {
      "id": "fonts",
      "title": "Licensed fonts",
      "role": "asset",
      "select": { "include": ["Fonts/**/*.{otf,ttf,woff,woff2}"] },
      "formats": ["otf", "ttf", "woff", "woff2"],
      "license": {
        "required": true,
        "registerCsv": {
          "path": "Fonts/licences.csv",
          "fileColumn": "File", "licenceColumn": "Licence", "licensorColumn": "Licensor",
          "expiresColumn": "Expires", "scopeColumn": "Scope",
          "allowedScopes": ["Client delivery", "Unlimited"]
        },
        "sidecar": ["LICENSE*.txt", "OFL*.txt"],
        "includeEvidence": true
      },
      "target": { "folder": "03_Fonts" }
    }
  ]
}

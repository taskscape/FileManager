IDD_DEFINESET DIALOGEX 9, 20, 269, 192
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Zdefiniuj zestaw znaków"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Znaki w &zestawie:",IDC_STATIC_1,7,7,65,8
    EDITTEXT        IDE_SET,7,17,255,12,ES_AUTOHSCROLL
    LTEXT           "Wskazówki:\n\nUżyj „-”, aby uwzględnić zakres znaków (np. A-Z).\n\nAby uwzględnić znak „-”, wpisz go na początku lub na końcu zestawu (np. -AZ).",IDC_STATIC_2,7,36,255,40
    LTEXT           "Aby uwzględnić znak „]”, wpisz go na początku zestawu.\n\nAby uwzględnić znak „^” w dodatnim zestawie znaków, wpisz go gdziekolwiek, ale nie na początku zestawu.",IDC_STATIC_3,7,84,255,32
    LTEXT           "Aby uwzględnić klasę znaków POSIX, użyj [:class:], gdzie class to jedna z wartości: alpha, alnum, ascii, blank, cntrl, digit, graph, lower, print, punct, space, upper, word, xdigit.\n\nAby użyć odwrotnego ukośnika, wpisz \\\\.",IDC_STATIC_4,7,124,255,40
    DEFPUSHBUTTON   "OK",IDOK,82,171,50,14
    PUSHBUTTON      "Anuluj",IDCANCEL,136,171,50,14
END


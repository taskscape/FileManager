#pragma code_page(65001)

#include "lang.rh"
#include "..\reorganize.rh"
#include "winresrc.h"

LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL

IDD_REORG_NEWPLAN DIALOGEX 0, 0, 260, 92
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "New reorganization plan"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT "Name:", IDC_STATIC, 7, 8, 40, 8
    EDITTEXT IDE_NAME, 50, 6, 200, 12, ES_AUTOHSCROLL
    LTEXT "Scope:", IDC_STATIC, 7, 26, 40, 8
    EDITTEXT IDE_SCOPE, 50, 24, 200, 12, ES_AUTOHSCROLL
    LTEXT "Destination:", IDC_STATIC, 7, 44, 40, 8
    EDITTEXT IDE_DEST, 50, 42, 200, 12, ES_AUTOHSCROLL
    DEFPUSHBUTTON "OK", IDOK, 144, 68, 50, 14
    PUSHBUTTON "Cancel", IDCANCEL, 200, 68, 50, 14
END

IDD_REORG_REMOVEFROMPLAN DIALOGEX 0, 0, 260, 78
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Remove from plan"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT "The selected items are removed from the plan. No files are deleted.", IDC_STATIC, 7, 8, 246, 16
    CONTROL "Unstage moves into removed folders", IDC_UNSTAGE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 7, 30, 200, 10
    DEFPUSHBUTTON "Remove", IDOK, 144, 54, 50, 14
    PUSHBUTTON "Cancel", IDCANCEL, 200, 54, 50, 14
END

IDD_REORG_REVIEW DIALOGEX 0, 0, 320, 180
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Plan review"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LISTBOX IDC_ISSUES, 7, 7, 306, 148, LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "Close", IDOK, 263, 160, 50, 14
END

IDD_REORG_APPLY DIALOGEX 0, 0, 260, 70
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Apply plan"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT "Apply the reviewed steps. Files are moved, never copied or permanently deleted.", IDC_STATIC, 7, 8, 246, 20
    CONTROL "Clean up emptied folders", IDC_CLEANUP, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 7, 32, 180, 10
    DEFPUSHBUTTON "Apply", IDOK, 144, 50, 50, 14
    PUSHBUTTON "Cancel", IDCANCEL, 200, 50, 50, 14
END

IDD_REORG_RULE DIALOGEX 0, 0, 280, 78
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Add rule"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT "Name mask:", IDC_STATIC, 7, 8, 50, 8
    EDITTEXT IDE_MASK, 60, 6, 210, 12, ES_AUTOHSCROLL
    LTEXT "Template:", IDC_STATIC, 7, 26, 50, 8
    EDITTEXT IDE_TEMPLATE, 60, 24, 210, 12, ES_AUTOHSCROLL
    DEFPUSHBUTTON "OK", IDOK, 164, 52, 50, 14
    PUSHBUTTON "Cancel", IDCANCEL, 220, 52, 50, 14
END

IDD_REORG_CONFIG DIALOGEX 0, 0, 220, 48
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Reorganize"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT "Recent plans are stored with the plug-in configuration.", IDC_STATIC, 7, 8, 206, 16
    DEFPUSHBUTTON "OK", IDOK, 163, 28, 50, 14
END

#include "lang.rc2"

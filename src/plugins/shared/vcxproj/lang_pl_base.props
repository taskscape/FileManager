<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ImportGroup Label="PropertySheets">
  </ImportGroup>
  <PropertyGroup Label="UserMacros"></PropertyGroup>
  <PropertyGroup>
    <OutDir>$(OPENSAL_BUILD_DIR)salamander\$(Configuration)_$(ShortPlatform)\plugins\$(ShortProjectName)\lang\</OutDir>
    <!-- Per-project intermediate keeps the Polish .res away from the English pack's shared Intermediate directory. -->
    <IntDir>$(OutDir)Intermediate\$(ProjectName)\</IntDir>
    <GenerateManifest>false</GenerateManifest>
    <TargetName>polish</TargetName>
<TargetExt>.slg</TargetExt>
<EmbedManifest>false</EmbedManifest>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <Link>
      <GenerateDebugInformation>false</GenerateDebugInformation>
      <SubSystem>Windows</SubSystem>
      <OutputFile>$(OutDir)polish.slg</OutputFile>
      <NoEntryPoint>true</NoEntryPoint>
    </Link>
    <ProjectReference>
      <LinkLibraryDependencies>false</LinkLibraryDependencies>
    </ProjectReference>
    <ResourceCompile>
      <AdditionalIncludeDirectories>..\..\shared;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <!-- Polish (Poland): 0x0415, matching the core polish.slg language identity. -->
      <Culture>0x0415</Culture>
      <PreprocessorDefinitions>WINVER=0x0601;_LANG;_LANG_POLISH;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ResourceCompile>
  </ItemDefinitionGroup>
</Project>

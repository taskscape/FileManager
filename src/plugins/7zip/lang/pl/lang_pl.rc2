//
// lang_pl.rc2 - Polish language resources (not edited by Visual Studio)
//

#ifdef APSTUDIO_INVOKED
#error this file is not editable by Microsoft Visual C++
#endif //APSTUDIO_INVOKED

// The Polish VERSIONINFO identity is applied before the shared VERSIONINFO
// template include; the plugin's versinfo.rh2 is include-guarded, so these
// overrides survive the template chain and keep POLISH.SLG valid for
// IsSLGFileValid (version match + 0x0415 translation language).
#include "..\..\versinfo.rh2"
#undef VERSINFO_INTERNAL
#define VERSINFO_INTERNAL    "POLISH"
#undef VERSINFO_ORIGINAL
#define VERSINFO_ORIGINAL    VERSINFO_INTERNAL ".SLG"
#undef VERSINFO_SLG_COMMENT
#define VERSINFO_SLG_COMMENT "Wersja polska"
#define VERSINFO_TRANSLATION_LANG    0x0415
#define VERSINFO_TRANSLATION_SUBLANG 0x0415
#include "versinfo.rc2"

// dialogs
IDD_ENTERPASSWORD DIALOGEX 6, 15, 257, 87
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Wprowadź hasło 7-Zip"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    ICON            "",IDC_LOCK_ICON,16,12,20,20
    LTEXT           "Ten plik jest zaszyfrowany. Wprowadź hasło, aby go odszyfrować.",IDC_STATIC_1,48,12,204,8
/*    LTEXT           "File:",IDC_STATIC_2,48,26,17,8
    LTEXT           "",IDC_FILE,65,26,175,8 */
    LTEXT           "Hasło:",IDC_STATIC_3,48,40,37,8
    EDITTEXT        IDC_PASSWORD,88,38,151,12,ES_PASSWORD | ES_AUTOHSCROLL
/*
 // preparation for skip and skip all
    DEFPUSHBUTTON   "OK",IDOK,12,63,50,14
    PUSHBUTTON      "Skip",IDC_SKIP,72,63,50,14
    PUSHBUTTON      "Skip all",IDC_SKIPALL,132,63,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,192,63,50,14
*/
    DEFPUSHBUTTON   "OK",IDOK,132,63,50,14
    PUSHBUTTON      "Anuluj",IDCANCEL,192,63,50,14
END


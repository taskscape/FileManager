    PUSHBUTTON      "Pomoc",IDHELP,139,122,50,14
END

IDD_SALMON_MAIN DIALOGEX 81, 47, 351, 215
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Zgłaszanie błędów Open Salamander"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Wystąpił problem, który zmusił Open Salamander do zamknięcia. Aby pomóc nam uniknąć podobnych problemów w przyszłości, wyślij poniższy raport o błędzie.",IDC_SALMON_INTRO,8,9,336,16
    // Split the disclosure into fixed lines so the Polish translation stays within RC's string limit.
    LTEXT           "Zgoda: Wyślij raport przesyła archiwum awarii (zrzut,",IDC_SALMON_PRIVACY,8,31,336,8
    LTEXT           "opcjonalny opis i adres e-mail) na reports.taskscape.com przez HTTPS.",IDC_SALMON_PRIVACY_LINE2,8,37,336,8
    LTEXT           "Wyświetl raport pozwala je obejrzeć. Nie wysyłaj raportu blokuje wysłanie;",IDC_SALMON_PRIVACY_LINE3,8,43,336,8
    LTEXT           "po czym możesz potwierdzić usunięcie.",IDC_SALMON_PRIVACY_LINE4,8,49,336,8
    LTEXT           "...",IDC_SALMON_UPLOADING,8,57,84,8
    LTEXT           "Opis błędu (opcjonalny)",IDC_SALMON_DESCRIPTION,8,66,169,8
    PUSHBUTTON      "&Wyświetl raport",IDC_SALMON_VIEW,254,63,90,14
    LTEXT           "&Ostatnia akcja:",IDC_SALMON_ACTION_LABEL,8,84,40,8
    EDITTEXT        IDC_SALMON_ACTION,8,94,336,54,ES_MULTILINE | ES_AUTOVSCROLL | ES_AUTOHSCROLL | ES_WANTRETURN | WS_VSCROLL
    LTEXT           "&Adres e-mail kontaktowy:",IDC_SALMON_EMAIL_LABEL,8,159,50,8
    EDITTEXT        IDC_SALMON_EMAIL,8,169,336,14,ES_AUTOHSCROLL
    CONTROL         "&Uruchom ponownie Open Salamander",IDC_SALMON_RESTART,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,8,193,98,10
    DEFPUSHBUTTON   "&Wyślij raport",IDOK,158,191,90,14
    PUSHBUTTON      "&Nie wysyłaj raportu",IDCANCEL,254,191,90,14
END

IDD_CONFIRMLINKTGTCOPY DIALOGEX 15, 34, 352, 96
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Potwierdź kopiowanie celu łącza"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    PUSHBUTTON      "&Tak",IDYES,31,73,50,14,WS_GROUP
    PUSHBUTTON      "&Wszystko",IDB_ALL,91,73,50,14
    DEFPUSHBUTTON   "&Pomiń",IDB_SKIP,151,73,50,14
    PUSHBUTTON      "P&omiń wszystko",IDB_SKIPALL,211,73,50,14
    PUSHBUTTON      "Anuluj",IDCANCEL,271,73,50,14
    RTEXT           "Łącze:",IDC_STATIC_3,3,10,31,8
    LTEXT           "",IDS_FILENAME,37,10,310,8,SS_NOPREFIX | NOT WS_GROUP
    RTEXT           "Szczegóły:",IDC_STATIC_4,3,23,31,8
    EDITTEXT        IDS_DETAILS,35,23,312,9,ES_AUTOHSCROLL | ES_READONLY | NOT WS_BORDER
    LTEXT           "Czy chcesz podążyć za łączem i skopiować pliki i katalogi z celu łącza?",IDC_STATIC_1,37,43,310,8,SS_NOPREFIX
    LTEXT           "Kliknij przycisk Pomiń, aby zignorować cel łącza i utworzyć tylko pusty katalog.",IDC_STATIC_2,37,51,310,8,SS_NOPREFIX
END

IDD_VIEWERGOTOOFFSET DIALOGEX 75, 140, 205, 81
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Przejdź do przesunięcia"

    CONTROL         "&HEX",IDC_VGTO_HEX,"Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,8,33,60,12
    DEFPUSHBUTTON   "OK",IDOK,19,59,50,14,WS_GROUP
    PUSHBUTTON      "Anuluj",IDCANCEL,77,59,50,14
    PUSHBUTTON      "Pomoc",IDHELP,135,59,50,14
END



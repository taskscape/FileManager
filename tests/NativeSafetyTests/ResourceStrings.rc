// Keep diacritics in the compiled UTF-16 resources so the test exercises the real Win32 resource boundary.
#pragma code_page(65001)
#include <windows.h>

STRINGTABLE
BEGIN
    4001 "&Utwórz katalog...\tF7"
    4002 "Zażółć gęślą jaźń"
    4003 "&Create Directory...\tF7"
    // Exercise the plug-in hint and network-status shapes as well as menu captions.
    4004 "Przeszukiwanie sieci…"
    4005 "Odzyskiwanie usuniętych plików"
END

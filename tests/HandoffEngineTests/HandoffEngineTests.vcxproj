           the Windows SDK, the C++ library, and src/common as dependencies (D-11). -->
      <AdditionalIncludeDirectories>..\..\src\plugins\handoff\engine;..\..\src;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>WINVER=0x0A00;_WIN32_WINNT=0x0A00;_CRT_SECURE_NO_WARNINGS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
      <AdditionalDependencies>Normaliz.lib;bcrypt.lib;windowscodecs.lib;ole32.lib;oleaut32.lib;shlwapi.lib;shcore.lib;runtimeobject.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>

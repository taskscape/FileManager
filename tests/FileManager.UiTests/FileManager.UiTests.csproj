<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- UI Automation must run on Windows because the application under test is native Win32. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <!-- Explicit test identity keeps discovery enabled across .NET SDK versions without command-line overrides. -->
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- FlaUI provides the UIA3 driver used to automate the FileManager Win32 interface. -->
    <PackageReference Include="FlaUI.UIA3" Version="5.0.0" />
    <!-- NUnit exposes the parameterized test cases and adapter used by dotnet test. -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="NUnit" Version="4.3.2" />
    <PackageReference Include="NUnit3TestAdapter" Version="5.0.0">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Built alongside the lane so the Edit case can copy a harness-owned
         editor into its disposable sandbox instead of driving whatever editor
         the current user has installed and running. -->
    <ProjectReference Include="..\FileManager.UiTests.EditorStub\FileManager.UiTests.EditorStub.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false" />
  </ItemGroup>
</Project>
